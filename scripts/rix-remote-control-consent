#!/usr/bin/env python3
import html
import os
from pathlib import Path
import stat
import subprocess
import sys

try:
    os.closerange(3, 1024)
except Exception:
    pass

ZENITY_CANDIDATES = (
    "/usr/bin/zenity",
    "/bin/zenity",
    "/usr/local/bin/zenity",
    "/usr/libexec/zenity",
)

def trusted_ancestors(path):
    current_uid = os.getuid()
    for parent in path.parents:
        try:
            metadata = parent.stat()
        except OSError:
            return False
        if metadata.st_uid not in (0, current_uid) or stat.S_IMODE(metadata.st_mode) & 0o022:
            return False
    return True

def trusted_zenity():
    current_uid = os.getuid()
    for candidate in ZENITY_CANDIDATES:
        try:
            resolved = Path(candidate).resolve(strict=True)
            metadata = resolved.stat()
        except (OSError, RuntimeError):
            continue
        if not stat.S_ISREG(metadata.st_mode):
            continue
        if metadata.st_uid not in (0, current_uid) or stat.S_IMODE(metadata.st_mode) & 0o022:
            continue
        if not trusted_ancestors(resolved):
            continue
        return str(resolved)
    return None

def main():
    if len(sys.argv) != 3:
        return 1
    try:
        devices = int(sys.argv[2])
    except ValueError:
        return 1
    if devices <= 0 or devices & ~3:
        return 1
    zenity = trusted_zenity()
    if zenity is None:
        return 1
    application = sys.argv[1][:256] or "Application"
    names = []
    if devices & 1:
        names.append("keyboard")
    if devices & 2:
        names.append("mouse")
    text = (f"<b>{html.escape(application)}</b> requests remote control of "
            f"{' and '.join(names)}.\n\n"
            "Permission remains active until this screencast ends or the session is locked.")
    environment = os.environ.copy()
    environment.pop("WAYLAND_SOCKET", None)
    try:
        result = subprocess.run([
            zenity, "--question", "--title=Remote Control",
            "--text=" + text, "--width=480", "--default-cancel",
            "--ok-label=Allow Control", "--cancel-label=Cancel",
            "--timeout=60",
        ], env=environment, timeout=65, check=False, close_fds=True)
    except (OSError, subprocess.TimeoutExpired):
        return 1
    return 0 if result.returncode == 0 else 1

if __name__ == "__main__":
    sys.exit(main())
