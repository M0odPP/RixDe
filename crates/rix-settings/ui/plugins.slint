import { Slider, ToggleSwitch } from "../../../ui/common/controls.slint";
import { SettingsTokens, SettingsIcons } from "tokens.slint";
import { SettingsCard, SettingsRow, SettingsDivider, ValueBadge, TagBadge, RixButton } from "card.slint";

export struct PluginChoice { id: string, name: string, description: string, capabilities: string, status: string, enabled: bool, available: bool, has-settings: bool }

export global PluginSettings {
    in-out property <[PluginChoice]> entries;
    in-out property <string> error;
    in-out property <int> capture-fps;
    callback apply-capture-rate();
    callback toggle(string, bool);
    callback settings(string);
    callback reload();
    callback open-folder();
}

export component PluginsView inherits Rectangle {
    background: transparent;
    preferred-height: content.preferred-height;
    vertical-stretch: 0;

    content := VerticalLayout {
        alignment: start;
        spacing: 16px;

        SettingsCard {
            title: @tr("Screencast and management");

            SettingsRow {
                title: @tr("Capture frame rate");
                subtitle: @tr("Maximum frame rate for desktop sharing and screen capture");
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Slider {
                        minimum: 1;
                        maximum: 60;
                        step: 5;
                        value: PluginSettings.capture-fps;
                        min-width: 160px;
                        changed(value) => { PluginSettings.capture-fps = round(value); }
                    }
                    ValueBadge { text: PluginSettings.capture-fps + " " + @tr("fps"); }
                }
            }

            SettingsDivider {}

            HorizontalLayout {
                spacing: 8px;
                RixButton {
                    text: @tr("Open extensions folder");
                    icon: SettingsIcons.folder;
                    clicked => { PluginSettings.open-folder(); }
                }
                RixButton {
                    text: @tr("Refresh");
                    icon: SettingsIcons.refresh;
                    clicked => { PluginSettings.reload(); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        SettingsCard {
            title: @tr("Installed extensions");
            subtitle: @tr("Extensions run in isolated processes with declared capabilities");

            if PluginSettings.entries.length == 0: Text {
                text: @tr("No desktop extensions installed");
                color: SettingsTokens.text-muted;
                font-size: SettingsTokens.text-md;
            }

            for plugin[index] in PluginSettings.entries: VerticalLayout {
                spacing: 0px;
                vertical-stretch: 0;
                if index > 0: SettingsDivider {}
                SettingsRow {
                    title: plugin.name;
                    subtitle: plugin.description + (plugin.capabilities != "" ? " · " + plugin.capabilities : "");
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;
                        if plugin.status != "": TagBadge {
                            text: plugin.status;
                            success: plugin.enabled && plugin.available;
                            warning: !plugin.available;
                        }
                        if plugin.has-settings: RixButton {
                            text: @tr("Configure");
                            icon: SettingsIcons.sliders;
                            enabled: plugin.available;
                            clicked => { PluginSettings.settings(plugin.id); }
                        }
                        ToggleSwitch {
                            checked: plugin.enabled;
                            enabled: plugin.available || plugin.enabled;
                            toggled => { PluginSettings.toggle(plugin.id, self.checked); }
                        }
                    }
                }
            }
        }

        if PluginSettings.error != "": Text {
            text: PluginSettings.error;
            color: SettingsTokens.danger;
            font-size: SettingsTokens.text-sm;
            wrap: word-wrap;
        }

        Text {
            text: @tr("Only enable extensions from trusted sources because they can interact with your active desktop session");
            color: SettingsTokens.text-muted;
            font-size: SettingsTokens.text-sm;
            wrap: word-wrap;
        }
    }
}
