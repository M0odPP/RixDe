import { ToggleSwitch, Slider } from "../../../ui/common/controls.slint";
import { ComboBox } from "../../../ui/common/combo_box.slint";
import { SettingsTokens } from "tokens.slint";
import { SettingsCard, SettingsRow, SettingsDivider, ValueBadge, TagBadge, RixSpinBox, RixButton } from "card.slint";

export struct DisplayItem {
    id: int,
    name: string,
    description: string,
    mode-text: string,
    is-primary: bool,
    is-mirrored: bool,
    mirror-name: string,
}

export global OutputPreferences {
    in-out property <bool> ready;
    in-out property <bool> native;
    in-out property <bool> busy;
    in-out property <bool> pending;
    in-out property <bool> confirm-ready;
    in-out property <int> remaining;
    in-out property <string> pending-output;
    in-out property <string> error;
    in-out property <[string]> outputs;
    in-out property <int> selected-output;
    in-out property <[DisplayItem]> display-items;
    in-out property <[string]> resolutions;
    in-out property <int> selected-resolution;
    in-out property <[string]> rates;
    in-out property <int> selected-rate;
    in-out property <bool> is-primary;
    in-out property <[string]> mirror-options;
    in-out property <int> selected-mirror-index;
    in-out property <bool> flipped;
    in-out property <float> scale-percent: 100;
    in-out property <int> rotation;
    in-out property <bool> automatic-position: true;
    in-out property <int> position-x;
    in-out property <int> position-y;
    callback select-output(int);
    callback select-resolution();
    callback select-mirror(int);
    callback toggle-primary();
    callback position-left-of();
    callback position-right-of();
    callback position-above();
    callback position-below();
    callback apply();
    callback confirm();
    callback revert();
}

export component DisplayStageTile inherits Rectangle {
    in property <string> index-label;
    in property <string> title;
    in property <string> spec;
    in property <bool> selected: false;
    in property <bool> is-primary: false;
    in property <bool> is-mirrored: false;
    in property <string> badge-text: "";
    callback clicked();

    min-width: 196px;
    max-width: 264px;
    height: 148px;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    VerticalLayout {
        spacing: 0px;
        alignment: center;

        screen := Rectangle {
            height: 132px;
            border-radius: SettingsTokens.radius-md;
            background: tile-touch.has-hover ? SettingsTokens.bg-hover : SettingsTokens.bg-card;
            border-width: 1px;
            border-color: SettingsTokens.border-strong;
            animate background { duration: SettingsTokens.duration-fast; easing: ease-out; }

            Rectangle {
                width: parent.width;
                height: parent.height;
                border-radius: parent.border-radius;
                background: SettingsTokens.is-light
                    ? @linear-gradient(180deg, #ffffff 0%, #f3f4f7 100%)
                    : (SettingsTokens.is-oled
                        ? @linear-gradient(180deg, #1b1c22 0%, #121318 100%)
                        : @linear-gradient(180deg, #25272d 0%, #1c1e23 100%));
                border-width: 1.5px;
                border-color: SettingsTokens.accent;
                opacity: root.selected ? 1.0 : 0.0;
                animate opacity { duration: SettingsTokens.duration-fast; easing: ease-out; }
            }

            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: root.selected ? SettingsTokens.accent : SettingsTokens.text-muted;
                            }
                        }
                        Text {
                            text: root.index-label;
                            font-family: SettingsTokens.font-mono;
                            font-size: SettingsTokens.text-xs;
                            font-weight: 500;
                            color: root.selected ? SettingsTokens.text-primary : SettingsTokens.text-muted;
                            vertical-alignment: center;
                        }
                    }

                    if root.is-primary: TagBadge {
                        text: @tr("Primary");
                        success: true;
                    }
                    if !root.is-primary && root.is-mirrored: TagBadge {
                        text: @tr("Mirror");
                        warning: true;
                    }
                    if !root.is-primary && !root.is-mirrored && root.badge-text != "": TagBadge {
                        text: root.badge-text;
                    }
                }

                Rectangle {
                    height: 28px;
                    border-radius: 4px;
                    background: SettingsTokens.is-light ? #17191c08 : #ffffff08;
                    border-width: 1px;
                    border-color: SettingsTokens.divider;
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: parent.height - 6px;
                        width: 44px;
                        height: 3px;
                        border-radius: 1.5px;
                        background: root.selected ? SettingsTokens.accent.with-alpha(0.7) : SettingsTokens.border-strong;
                    }
                }

                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: root.title;
                        font-size: SettingsTokens.text-md;
                        font-weight: 500;
                        color: SettingsTokens.text-primary;
                        overflow: elide;
                    }
                    Text {
                        text: root.spec;
                        font-family: SettingsTokens.font-mono;
                        font-size: SettingsTokens.text-xs;
                        color: SettingsTokens.text-muted;
                        overflow: elide;
                    }
                }
            }

            tile-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.clicked(); }
            }
        }

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 8px;
                background: SettingsTokens.border-strong;
            }
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 64px;
                height: 4px;
                border-radius: 2px;
                background: root.selected ? SettingsTokens.text-muted : SettingsTokens.border-strong;
            }
        }
    }
}

export component DisplayView inherits Rectangle {
    background: transparent;
    preferred-height: content.preferred-height;
    vertical-stretch: 0;

    content := VerticalLayout {
        alignment: start;
        spacing: 16px;

        if !OutputPreferences.ready && OutputPreferences.error == "": Text {
            text: @tr("Loading displays…");
            color: SettingsTokens.text-secondary;
            font-size: SettingsTokens.text-md;
        }
        if OutputPreferences.ready && OutputPreferences.native && OutputPreferences.outputs.length == 0: Text {
            text: @tr("No displays connected");
            color: SettingsTokens.text-secondary;
            font-size: SettingsTokens.text-md;
        }

        if OutputPreferences.pending: SettingsCard {
            title: @tr("Keep display changes?");
            subtitle: @tr("Reverting in ") + OutputPreferences.remaining + @tr(" s");

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                RixButton {
                    text: @tr("Revert");
                    enabled: !OutputPreferences.busy;
                    clicked => { OutputPreferences.revert(); }
                }
                RixButton {
                    text: @tr("Keep changes");
                    primary: true;
                    enabled: !OutputPreferences.busy && OutputPreferences.confirm-ready && OutputPreferences.remaining > 0;
                    clicked => { OutputPreferences.confirm(); }
                }
            }
        }

        if OutputPreferences.ready && OutputPreferences.native && OutputPreferences.outputs.length > 0: SettingsCard {
            title: @tr("Display arrangement");
            subtitle: @tr("Select a monitor to configure its resolution, scale and placement");

            Rectangle {
                min-height: 184px;
                border-radius: SettingsTokens.radius-md;
                background: SettingsTokens.bg-stage;
                border-width: 1px;
                border-color: SettingsTokens.border;

                Rectangle { x: 12px; y: 12px; width: 8px; height: 1px; background: SettingsTokens.border-strong; }
                Rectangle { x: 12px; y: 12px; width: 1px; height: 8px; background: SettingsTokens.border-strong; }
                Rectangle { x: parent.width - 20px; y: 12px; width: 8px; height: 1px; background: SettingsTokens.border-strong; }
                Rectangle { x: parent.width - 13px; y: 12px; width: 1px; height: 8px; background: SettingsTokens.border-strong; }

                HorizontalLayout {
                    padding: 20px;
                    spacing: 16px;
                    alignment: center;

                    for item[idx] in OutputPreferences.display-items: DisplayStageTile {
                        index-label: idx < 9 ? "0" + (idx + 1) : "" + (idx + 1);
                        title: item.description != "" ? item.description : item.name;
                        spec: item.mode-text;
                        selected: OutputPreferences.selected-output == idx;
                        is-primary: item.is-primary;
                        is-mirrored: item.is-mirrored;
                        clicked => { OutputPreferences.select-output(idx); }
                    }
                }
            }

            if OutputPreferences.display-items.length > 1 && OutputPreferences.selected-mirror-index == 0: SettingsDivider {}

            if OutputPreferences.display-items.length > 1 && OutputPreferences.selected-mirror-index == 0: SettingsRow {
                title: @tr("Quick placement");
                subtitle: @tr("Position selected display relative to the adjacent monitor");
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    RixButton {
                        text: @tr("Left");
                        enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                        clicked => { OutputPreferences.position-left-of(); }
                    }
                    RixButton {
                        text: @tr("Right");
                        enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                        clicked => { OutputPreferences.position-right-of(); }
                    }
                    RixButton {
                        text: @tr("Above");
                        enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                        clicked => { OutputPreferences.position-above(); }
                    }
                    RixButton {
                        text: @tr("Below");
                        enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                        clicked => { OutputPreferences.position-below(); }
                    }
                }
            }
        }

        if OutputPreferences.ready && OutputPreferences.native && OutputPreferences.outputs.length > 0: SettingsCard {
            title: @tr("Output configuration");

            SettingsRow {
                title: @tr("Display");
                ComboBox {
                    model: OutputPreferences.outputs;
                    current-index <=> OutputPreferences.selected-output;
                    enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                    selected(_) => { OutputPreferences.select-output(OutputPreferences.selected-output); }
                    min-width: 208px;
                }
            }

            SettingsDivider {}

            SettingsRow {
                title: @tr("Primary display");
                subtitle: @tr("Show the main panel and open new windows on this monitor");
                ToggleSwitch {
                    checked <=> OutputPreferences.is-primary;
                    enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                    toggled => { OutputPreferences.toggle-primary(); }
                }
            }

            if OutputPreferences.mirror-options.length > 1: SettingsDivider {}

            if OutputPreferences.mirror-options.length > 1: SettingsRow {
                title: @tr("Display mode");
                subtitle: @tr("Extend desktop or mirror another output");
                ComboBox {
                    model: OutputPreferences.mirror-options;
                    current-index <=> OutputPreferences.selected-mirror-index;
                    enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                    selected(_) => { OutputPreferences.select-mirror(OutputPreferences.selected-mirror-index); }
                    min-width: 208px;
                }
            }

            SettingsDivider {}

            SettingsRow {
                title: @tr("Resolution");
                ComboBox {
                    model: OutputPreferences.resolutions;
                    current-index <=> OutputPreferences.selected-resolution;
                    enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                    selected(_) => { OutputPreferences.select-resolution(); }
                    min-width: 208px;
                }
            }

            SettingsDivider {}

            SettingsRow {
                title: @tr("Refresh rate");
                ComboBox {
                    model: OutputPreferences.rates;
                    current-index <=> OutputPreferences.selected-rate;
                    enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                    min-width: 208px;
                }
            }

            SettingsDivider {}

            SettingsRow {
                title: @tr("Scale");
                subtitle: @tr("Interface scale factor for high-DPI screens");
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Slider {
                        value <=> OutputPreferences.scale-percent;
                        minimum: 50;
                        maximum: 400;
                        enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                        min-width: 160px;
                    }
                    ValueBadge { text: round(OutputPreferences.scale-percent) + "%"; }
                }
            }

            SettingsDivider {}

            SettingsRow {
                title: @tr("Orientation");
                ComboBox {
                    model: [@tr("Normal"), @tr("Rotate 90°"), @tr("Rotate 180°"), @tr("Rotate 270°")];
                    current-index <=> OutputPreferences.rotation;
                    enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                    min-width: 208px;
                }
            }

            SettingsDivider {}

            SettingsRow {
                title: @tr("Flip display");
                subtitle: @tr("Invert output 180 degrees");
                ToggleSwitch {
                    checked <=> OutputPreferences.flipped;
                    enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                }
            }

            if OutputPreferences.selected-mirror-index == 0: SettingsDivider {}

            if OutputPreferences.selected-mirror-index == 0: SettingsRow {
                title: @tr("Automatic arrangement");
                subtitle: @tr("Place secondary monitors adjacent to the primary display");
                ToggleSwitch {
                    checked <=> OutputPreferences.automatic-position;
                    enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                }
            }

            if OutputPreferences.selected-mirror-index == 0 && !OutputPreferences.automatic-position: SettingsDivider {}

            if OutputPreferences.selected-mirror-index == 0 && !OutputPreferences.automatic-position: SettingsRow {
                title: @tr("Desktop coordinates");
                subtitle: @tr("Manual X and Y offset in logical pixels");
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Text {
                        text: "X";
                        font-family: SettingsTokens.font-mono;
                        font-size: SettingsTokens.text-sm;
                        color: SettingsTokens.text-muted;
                        vertical-alignment: center;
                    }
                    RixSpinBox {
                        value <=> OutputPreferences.position-x;
                        minimum: -32768;
                        maximum: 32768;
                        step: 10;
                        readout-min-width: 56px;
                        enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                    }
                    Text {
                        text: "Y";
                        font-family: SettingsTokens.font-mono;
                        font-size: SettingsTokens.text-sm;
                        color: SettingsTokens.text-muted;
                        vertical-alignment: center;
                    }
                    RixSpinBox {
                        value <=> OutputPreferences.position-y;
                        minimum: -32768;
                        maximum: 32768;
                        step: 10;
                        readout-min-width: 56px;
                        enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                    }
                }
            }
        }

        if OutputPreferences.error != "": Text {
            text: OutputPreferences.error;
            color: SettingsTokens.danger;
            font-size: SettingsTokens.text-sm;
            wrap: word-wrap;
        }
    }
}
