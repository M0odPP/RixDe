import { Theme } from "../../../ui/common/theme.slint";
import { ToggleSwitch, Slider } from "../../../ui/common/controls.slint";
import { Button, SpinBox } from "std-widgets.slint";
import { ComboBox } from "../../../ui/common/combo_box.slint";
import { SettingsCard, SettingsRow, SettingsDivider, ValueBadge, RixButton } from "card.slint";

export struct DisplayItem {
    id: int,
    name: string,
    description: string,
    mode-text: string,
    is-primary: bool,
    is-mirrored: bool,
    mirror-name: string,
}

export global OutputPreferences {
    in-out property <bool> ready;
    in-out property <bool> native;
    in-out property <bool> busy;
    in-out property <bool> pending;
    in-out property <bool> confirm-ready;
    in-out property <int> remaining;
    in-out property <string> pending-output;
    in-out property <string> error;
    in-out property <[string]> outputs;
    in-out property <int> selected-output;
    in-out property <[DisplayItem]> display-items;
    in-out property <[string]> resolutions;
    in-out property <int> selected-resolution;
    in-out property <[string]> rates;
    in-out property <int> selected-rate;
    in-out property <bool> is-primary;
    in-out property <[string]> mirror-options;
    in-out property <int> selected-mirror-index;
    in-out property <bool> flipped;
    in-out property <float> scale-percent: 100;
    in-out property <int> rotation;
    in-out property <bool> automatic-position: true;
    in-out property <int> position-x;
    in-out property <int> position-y;
    callback select-output(int);
    callback select-resolution();
    callback select-mirror(int);
    callback toggle-primary();
    callback position-left-of();
    callback position-right-of();
    callback position-above();
    callback position-below();
    callback apply();
    callback confirm();
    callback revert();
}

component Label inherits Text {
    color: Theme.text-secondary;
    font-size: Theme.font-size-md;
    vertical-alignment: center;
}

export component DisplayView inherits Rectangle {
    preferred-height: content.preferred-height;
    vertical-stretch: 0;
    content := VerticalLayout {
        spacing: 16px;

        if !OutputPreferences.ready && OutputPreferences.error == "": Label { text: @tr("Loading displays…"); }
        if OutputPreferences.ready && !OutputPreferences.native: Label { text: @tr("Nested session window size"); }
        if OutputPreferences.ready && OutputPreferences.native && OutputPreferences.outputs.length == 0: Label { text: @tr("No displays connected"); }

        if OutputPreferences.ready && OutputPreferences.native && OutputPreferences.outputs.length > 0: SettingsCard {
            title: @tr("Display arrangement");
            subtitle: @tr("Select a screen to configure its placement, resolution and mode");

            HorizontalLayout {
                spacing: 14px;
                alignment: center;
                padding-top: 6px;
                padding-bottom: 6px;

                for item[idx] in OutputPreferences.display-items: Rectangle {
                    min-width: 180px;
                    max-width: 260px;
                    height: 120px;
                    border-radius: Theme.radius-md;
                    background: OutputPreferences.selected-output == idx ? Theme.surface-active : Theme.control-surface;
                    border-width: OutputPreferences.selected-output == idx ? 2px : 1px;
                    border-color: OutputPreferences.selected-output == idx ? Theme.accent : Theme.control-border;
                    clip: true;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        alignment: space-between;

                        HorizontalLayout {
                            alignment: space-between;

                            Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 12px;
                                background: OutputPreferences.selected-output == idx ? Theme.accent : Theme.control-border;
                                Text {
                                    text: (idx + 1);
                                    color: OutputPreferences.selected-output == idx ? #ffffff : Theme.text-primary;
                                    font-size: 12px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            if item.is-primary: Rectangle {
                                height: 22px;
                                border-radius: 11px;
                                background: Theme.accent;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: @tr("Primary");
                                        color: #ffffff;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if item.is-mirrored: Rectangle {
                                height: 22px;
                                border-radius: 11px;
                                background: #e67e22;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: @tr("Mirror");
                                        color: #ffffff;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 3px;
                            Text {
                                text: item.description != "" ? item.description : item.name;
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text-primary;
                                overflow: elide;
                            }
                            Text {
                                text: item.mode-text;
                                font-size: 11px;
                                color: Theme.text-secondary;
                                overflow: elide;
                            }
                        }
                    }

                    TouchArea {
                        clicked => {
                            OutputPreferences.select-output(idx);
                        }
                    }
                }
            }

            if OutputPreferences.display-items.length > 1 && OutputPreferences.selected-mirror-index == 0: SettingsDivider {}

            if OutputPreferences.display-items.length > 1 && OutputPreferences.selected-mirror-index == 0: SettingsRow {
                title: @tr("Quick placement");
                subtitle: @tr("Align with adjacent display");
                HorizontalLayout {
                    spacing: 8px; alignment: end;
                    Button {
                        text: @tr("Left of other");
                        enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                        clicked => { OutputPreferences.position-left-of(); }
                    }
                    Button {
                        text: @tr("Right of other");
                        enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                        clicked => { OutputPreferences.position-right-of(); }
                    }
                    Button {
                        text: @tr("Above other");
                        enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                        clicked => { OutputPreferences.position-above(); }
                    }
                    Button {
                        text: @tr("Below other");
                        enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                        clicked => { OutputPreferences.position-below(); }
                    }
                }
            }
        }

        if OutputPreferences.ready && OutputPreferences.native && OutputPreferences.outputs.length > 0: SettingsCard {
            title: @tr("Display settings");
            subtitle: @tr("Mode, resolution, refresh rate and monitor scaling");

            SettingsRow {
                title: @tr("Display screen");
                ComboBox {
                    model: OutputPreferences.outputs;
                    current-index <=> OutputPreferences.selected-output;
                    enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                    selected(_) => { OutputPreferences.select-output(OutputPreferences.selected-output); }
                    min-width: 220px;
                }
            }

            SettingsDivider {}

            SettingsRow {
                title: @tr("Primary display");
                subtitle: @tr("Show main desktop panel and launch new windows here");
                ToggleSwitch {
                    checked <=> OutputPreferences.is-primary;
                    enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                    toggled => { OutputPreferences.toggle-primary(); }
                }
            }

            if OutputPreferences.mirror-options.length > 1: SettingsDivider {}

            if OutputPreferences.mirror-options.length > 1: SettingsRow {
                title: @tr("Display mode");
                subtitle: @tr("Extend desktop or duplicate display for capture card / streaming");
                ComboBox {
                    model: OutputPreferences.mirror-options;
                    current-index <=> OutputPreferences.selected-mirror-index;
                    enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                    selected(_) => { OutputPreferences.select-mirror(OutputPreferences.selected-mirror-index); }
                    min-width: 220px;
                }
            }

            SettingsDivider {}

            SettingsRow {
                title: @tr("Resolution");
                subtitle: @tr("Pixel width and height");
                ComboBox {
                    model: OutputPreferences.resolutions;
                    current-index <=> OutputPreferences.selected-resolution;
                    enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                    selected(_) => { OutputPreferences.select-resolution(); }
                    min-width: 220px;
                }
            }

            SettingsDivider {}

            SettingsRow {
                title: @tr("Refresh rate");
                subtitle: @tr("Display vertical frequency in Hertz");
                ComboBox {
                    model: OutputPreferences.rates;
                    current-index <=> OutputPreferences.selected-rate;
                    enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                    min-width: 220px;
                }
            }

            SettingsDivider {}

            SettingsRow {
                title: @tr("Display scale");
                subtitle: @tr("Scale factor for high DPI displays");
                HorizontalLayout {
                    spacing: 10px; alignment: center;
                    Slider {
                        value <=> OutputPreferences.scale-percent;
                        minimum: 50; maximum: 400;
                        enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                        min-width: 160px;
                    }
                    ValueBadge { text: round(OutputPreferences.scale-percent) + "%"; }
                }
            }

            SettingsDivider {}

            SettingsRow {
                title: @tr("Orientation");
                subtitle: @tr("Display rotation angle");
                ComboBox {
                    model: [@tr("Normal orientation"), @tr("Rotate 90°"), @tr("Rotate 180°"), @tr("Rotate 270°")];
                    current-index <=> OutputPreferences.rotation;
                    enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                    min-width: 220px;
                }
            }

            SettingsDivider {}

            SettingsRow {
                title: @tr("Flip display");
                subtitle: @tr("Invert orientation 180 degrees");
                ToggleSwitch {
                    checked <=> OutputPreferences.flipped;
                    enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                }
            }

            if OutputPreferences.selected-mirror-index == 0: SettingsDivider {}

            if OutputPreferences.selected-mirror-index == 0: SettingsRow {
                title: @tr("Arrange displays automatically");
                subtitle: @tr("Place secondary monitors adjacent to primary display");
                ToggleSwitch {
                    checked <=> OutputPreferences.automatic-position;
                    enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                }
            }

            if OutputPreferences.selected-mirror-index == 0 && !OutputPreferences.automatic-position: SettingsDivider {}

            if OutputPreferences.selected-mirror-index == 0 && !OutputPreferences.automatic-position: SettingsRow {
                title: @tr("Display position");
                subtitle: @tr("X and Y desktop coordinates");
                HorizontalLayout {
                    spacing: 8px; alignment: center;
                    Label { text: "X:"; }
                    SpinBox { value <=> OutputPreferences.position-x; minimum: -32768; maximum: 32768; enabled: !OutputPreferences.busy && !OutputPreferences.pending; }
                    Label { text: "Y:"; }
                    SpinBox { value <=> OutputPreferences.position-y; minimum: -32768; maximum: 32768; enabled: !OutputPreferences.busy && !OutputPreferences.pending; }
                }
            }

            SettingsDivider {}

            HorizontalLayout {
                alignment: end;
                padding-top: 4px;
                padding-bottom: 4px;

                RixButton {
                    text: @tr("Apply display settings");
                    primary: true;
                    enabled: !OutputPreferences.busy && !OutputPreferences.pending;
                    clicked => { OutputPreferences.apply(); }
                }
            }
        }

        if OutputPreferences.pending: SettingsCard {
            title: @tr("Confirm display mode change");
            subtitle: @tr("Reverting in ") + OutputPreferences.remaining + @tr(" s");
            HorizontalLayout {
                spacing: 12px; alignment: end;
                Button { text: @tr("Revert"); enabled: !OutputPreferences.busy; clicked => { OutputPreferences.revert(); } }
                Button { text: @tr("Keep changes"); primary: true; enabled: !OutputPreferences.busy && OutputPreferences.confirm-ready && OutputPreferences.remaining > 0; clicked => { OutputPreferences.confirm(); } }
            }
        }

        if OutputPreferences.error != "": Text { text: OutputPreferences.error; color: Theme.accent; font-size: Theme.font-size-md; wrap: word-wrap; }
    }
}
