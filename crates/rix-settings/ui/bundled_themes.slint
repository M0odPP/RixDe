import { ToggleSwitch } from "../../../ui/common/controls.slint";
import { SettingsTokens } from "tokens.slint";
import { SettingsCard, SettingsRow, SettingsDivider, RixButton } from "card.slint";

export struct InstalledTheme { id: string, name: string, description: string }

export global BundledThemes {
    in-out property <[InstalledTheme]> packages;
    in-out property <bool> include-layout: true;
    callback apply(string);
}

export component BundledThemesView inherits Rectangle {
    in property <bool> busy;
    background: transparent;
    preferred-height: content.preferred-height;
    vertical-stretch: 0;

    content := VerticalLayout {
        alignment: start;
        spacing: 16px;

        if BundledThemes.packages.length > 0: SettingsCard {
            title: @tr("Installed themes");

            for package[idx] in BundledThemes.packages: VerticalLayout {
                spacing: 0px;
                vertical-stretch: 0;
                if idx > 0: SettingsDivider {}
                SettingsRow {
                    title: package.name;
                    subtitle: package.description;
                    RixButton {
                        text: @tr("Apply");
                        primary: true;
                        enabled: !root.busy;
                        clicked => { BundledThemes.apply(package.id); }
                    }
                }
            }

            SettingsDivider {}

            SettingsRow {
                title: @tr("Include panel and menu layout");
                subtitle: @tr("Apply the theme package's taskbar geometry along with colors");
                ToggleSwitch { checked <=> BundledThemes.include-layout; }
            }
        }
    }
}
