import { LineEdit } from "../../../ui/common/line_edit.slint";
import { ApplicationChooserPanel } from "../../../ui/common/application_chooser.slint";
import { SettingsTokens } from "tokens.slint";
import { SettingsCard, SettingsRow, SettingsDivider, RixButton } from "card.slint";

export struct DefaultAppGroup { id: string, icon: image, label: string, detail: string, application: string }

export global DefaultAppsSettings {
    in-out property <[DefaultAppGroup]> groups;
    in-out property <string> status;
    in-out property <bool> busy;
    in-out property <string> custom-mime;
    in-out property <bool> chooser-visible;
    callback choose(string);
}

export component DefaultAppsView inherits Rectangle {
    background: transparent;
    preferred-height: DefaultAppsSettings.chooser-visible
        ? Math.max(content.preferred-height, 560px)
        : content.preferred-height;
    vertical-stretch: 0;

    content := VerticalLayout {
        alignment: start;
        spacing: 16px;

        SettingsCard {
            title: @tr("Default applications");
            subtitle: @tr("Preferred programs for web, mail, media and files");

            for group[index] in DefaultAppsSettings.groups: VerticalLayout {
                spacing: 0px;
                vertical-stretch: 0;
                if index > 0: SettingsDivider {}
                SettingsRow {
                    title: group.label;
                    subtitle: group.detail;
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: end;

                        HorizontalLayout {
                            width: 224px;
                            spacing: 10px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    border-radius: SettingsTokens.radius-sm;
                                    background: SettingsTokens.bg-raised;
                                    border-width: 1px;
                                    border-color: SettingsTokens.border;
                                    Image {
                                        source: group.icon;
                                        width: 16px;
                                        height: 16px;
                                        x: 4px;
                                        y: 4px;
                                        image-fit: contain;
                                    }
                                }
                            }
                            Text {
                                text: group.application != "" ? group.application : @tr("None");
                                color: group.application != "" ? SettingsTokens.text-primary : SettingsTokens.text-muted;
                                font-weight: 400;
                                font-size: SettingsTokens.text-md;
                                horizontal-stretch: 1;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }

                        RixButton {
                            text: @tr("Change");
                            enabled: !DefaultAppsSettings.busy;
                            clicked => { DefaultAppsSettings.choose(group.id); }
                        }
                    }
                }
            }
        }

        SettingsCard {
            title: @tr("Custom file association");
            subtitle: @tr("Assign a default handler to any MIME type");

            SettingsRow {
                title: @tr("MIME type");
                subtitle: @tr("Standard format identifier");
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    LineEdit {
                        placeholder-text: "application/pdf";
                        text <=> DefaultAppsSettings.custom-mime;
                        enabled: !DefaultAppsSettings.busy;
                        min-width: 208px;
                        accepted(_) => { DefaultAppsSettings.choose("custom"); }
                    }
                    RixButton {
                        text: @tr("Choose application");
                        enabled: !DefaultAppsSettings.busy;
                        clicked => { DefaultAppsSettings.choose("custom"); }
                    }
                }
            }
        }

        if DefaultAppsSettings.status != "": Text {
            text: DefaultAppsSettings.status;
            color: SettingsTokens.text-secondary;
            font-size: SettingsTokens.text-sm;
            wrap: word-wrap;
        }
    }

    if DefaultAppsSettings.chooser-visible: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        border-radius: SettingsTokens.radius-lg;
        background: SettingsTokens.bg-canvas.with-alpha(0.92);
        TouchArea {}
        chooser := ApplicationChooserPanel {
            width: Math.min(620px, parent.width - 32px);
            height: Math.min(540px, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: 16px;
            init => { self.focus-chooser(); }
        }
    }
}
