import { Slider, ToggleSwitch } from "../../../ui/common/controls.slint";
import { ComboBox } from "../../../ui/common/combo_box.slint";
import { SettingsTokens, SettingsIcons } from "tokens.slint";
import { SettingsCard, SettingsRow, SettingsDivider, ValueBadge, RixButton } from "card.slint";

export global WallpaperPreferences {
    in-out property <string> path;
    in-out property <string> filename;
    in-out property <string> error;
    in-out property <image> preview;
    in-out property <int> fit;
    in-out property <float> blur;
    in-out property <float> dim;
    in-out property <bool> animate;
    in-out property <int> max-fps;
    in-out property <color> fill-color;
    in-out property <bool> choosing;
    callback choose();
    callback clear();
    callback apply();
}

export component WallpaperView inherits Rectangle {
    background: transparent;
    preferred-height: form.preferred-height;
    vertical-stretch: 0;

    form := VerticalLayout {
        alignment: start;
        spacing: 16px;

        SettingsCard {
            title: @tr("Current wallpaper");

            Rectangle {
                height: 240px;
                border-radius: SettingsTokens.radius-md;
                background: WallpaperPreferences.fill-color;
                border-width: 1px;
                border-color: SettingsTokens.border-strong;
                clip: true;

                Image {
                    source: WallpaperPreferences.preview;
                    image-fit: contain;
                    width: 100%;
                    height: 100%;
                }

                Rectangle {
                    background: #000000;
                    opacity: WallpaperPreferences.dim;
                    width: 100%;
                    height: 100%;
                }

                Rectangle {
                    x: 12px;
                    y: parent.height - self.height - 12px;
                    width: parent.width - 24px;
                    height: 48px;
                    border-radius: SettingsTokens.radius-md;
                    background: SettingsTokens.bg-card.with-alpha(0.92);
                    border-width: 1px;
                    border-color: SettingsTokens.border-strong;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;
                        spacing: 12px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: WallpaperPreferences.filename != "" ? WallpaperPreferences.filename : @tr("Solid color");
                                color: SettingsTokens.text-primary;
                                font-family: SettingsTokens.font-mono;
                                font-size: SettingsTokens.text-sm;
                                font-weight: 400;
                                overflow: elide;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 0;
                            alignment: center;
                            HorizontalLayout {
                                spacing: 8px;
                                RixButton {
                                    text: WallpaperPreferences.choosing ? @tr("Choosing…") : @tr("Choose image");
                                    icon: SettingsIcons.wallpaper;
                                    primary: true;
                                    enabled: !WallpaperPreferences.choosing;
                                    clicked => { WallpaperPreferences.choose(); }
                                }
                                RixButton {
                                    text: @tr("Solid color");
                                    clicked => { WallpaperPreferences.clear(); }
                                }
                            }
                        }
                    }
                }
            }

            SettingsDivider {}

            SettingsRow {
                title: @tr("Placement");
                subtitle: @tr("How the image scales to the screen");
                ComboBox {
                    model: [@tr("Fill screen"), @tr("Fit"), @tr("Stretch"), @tr("Center")];
                    current-index <=> WallpaperPreferences.fit;
                    min-width: 208px;
                }
            }

            SettingsDivider {}

            SettingsRow {
                title: @tr("Background fill");
                subtitle: @tr("Color shown behind centered or solid-color wallpapers");
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    for color in [#14161b, #232832, #323e4c, #2b3a35, #3a3444, #d8dce4, #000000]: Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: color;
                        border-width: WallpaperPreferences.fill-color == color ? 2px : 1px;
                        border-color: WallpaperPreferences.fill-color == color ? SettingsTokens.text-primary : SettingsTokens.border-strong;
                        animate border-color { duration: SettingsTokens.duration-fast; easing: ease-out; }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { WallpaperPreferences.fill-color = color; }
                        }
                    }
                }
            }
        }

        SettingsCard {
            title: @tr("Effects and playback");

            SettingsRow {
                title: @tr("Blur");
                subtitle: @tr("Soften the desktop background behind windows");
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Slider { value <=> WallpaperPreferences.blur; minimum: 0; maximum: 80; min-width: 160px; }
                    ValueBadge { text: round(WallpaperPreferences.blur) + " px"; }
                }
            }

            SettingsDivider {}

            SettingsRow {
                title: @tr("Dimming");
                subtitle: @tr("Darken bright backgrounds to improve text contrast");
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Slider { value <=> WallpaperPreferences.dim; minimum: 0; maximum: 1; min-width: 160px; }
                    ValueBadge { text: round(WallpaperPreferences.dim * 100) + "%"; }
                }
            }

            SettingsDivider {}

            SettingsRow {
                title: @tr("Animated wallpapers");
                subtitle: @tr("Play GIF, WebP and video files on the desktop");
                ToggleSwitch { checked <=> WallpaperPreferences.animate; }
            }

            if WallpaperPreferences.animate: SettingsDivider {}

            if WallpaperPreferences.animate: SettingsRow {
                title: @tr("Frame rate limit");
                subtitle: @tr("Maximum playback rate for video backgrounds");
                ComboBox {
                    model: [@tr("15 fps"), @tr("30 fps"), @tr("60 fps")];
                    current-index: WallpaperPreferences.max-fps <= 15 ? 0 : WallpaperPreferences.max-fps <= 30 ? 1 : 2;
                    selected(_) => { WallpaperPreferences.max-fps = self.current-index == 0 ? 15 : self.current-index == 1 ? 30 : 60; }
                    min-width: 208px;
                }
            }
        }

        if WallpaperPreferences.error != "": Text {
            text: WallpaperPreferences.error;
            color: SettingsTokens.danger;
            font-size: SettingsTokens.text-sm;
            wrap: word-wrap;
        }
    }
}
