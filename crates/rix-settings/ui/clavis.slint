import { SettingsTokens, SettingsIcons } from "tokens.slint";
import { SettingsCard, SettingsRow, SettingsDivider, TagBadge, RixButton } from "card.slint";

export struct ClavisProviderChoice { id: string, name: string, detail: string, available: bool }

export global ClavisSettings {
    in-out property <string> provider;
    in-out property <string> next-provider;
    in-out property <string> selected;
    in-out property <[ClavisProviderChoice]> choices;
    in-out property <string> status;
    in-out property <bool> busy;
    callback open();
    callback choose(string);
}

export component ClavisView inherits Rectangle {
    private property <image> empty-icon;
    background: transparent;
    preferred-height: content.preferred-height;
    vertical-stretch: 0;

    content := VerticalLayout {
        alignment: start;
        spacing: 16px;

        SettingsCard {
            title: @tr("Clavis vault");
            subtitle: @tr("Encrypted passwords, tokens and Secret Service credentials");

            HorizontalLayout {
                RixButton {
                    text: @tr("Open Clavis");
                    icon: SettingsIcons.vault;
                    primary: true;
                    clicked => { ClavisSettings.open(); }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            SettingsDivider {}

            SettingsRow {
                title: @tr("Active session provider");
                subtitle: @tr("Secret Service backend running in this session");
                TagBadge {
                    text: ClavisSettings.provider;
                    success: true;
                }
            }

            SettingsDivider {}

            SettingsRow {
                title: @tr("Next login provider");
                subtitle: @tr("Backend scheduled for your next desktop session");
                Text {
                    text: ClavisSettings.next-provider;
                    font-family: SettingsTokens.font-mono;
                    color: SettingsTokens.text-primary;
                    font-size: SettingsTokens.text-sm;
                    vertical-alignment: center;
                }
            }
        }

        SettingsCard {
            title: @tr("Secret providers");
            subtitle: @tr("Choose which keyring stores encrypted credentials and browser keys");

            for choice[index] in ClavisSettings.choices: VerticalLayout {
                spacing: 0px;
                vertical-stretch: 0;
                if index > 0: SettingsDivider {}
                SettingsRow {
                    title: choice.name;
                    subtitle: choice.detail;
                    RixButton {
                        text: ClavisSettings.selected == choice.id ? @tr("Selected") : @tr("Choose");
                        icon: ClavisSettings.selected == choice.id ? SettingsIcons.check : root.empty-icon;
                        primary: ClavisSettings.selected == choice.id;
                        enabled: choice.available && !ClavisSettings.busy;
                        clicked => { ClavisSettings.choose(choice.id); }
                    }
                }
            }
        }

        if ClavisSettings.status != "": Text {
            text: ClavisSettings.status;
            color: SettingsTokens.text-secondary;
            font-size: SettingsTokens.text-sm;
            wrap: word-wrap;
        }

        Text {
            text: @tr("Clavis integrates with Secret Service and the Secret portal. Existing browser encryption keys stay in their current provider until migrated.");
            color: SettingsTokens.text-muted;
            font-size: SettingsTokens.text-sm;
            wrap: word-wrap;
        }
    }
}
