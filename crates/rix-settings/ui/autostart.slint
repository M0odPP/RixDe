import { ToggleSwitch } from "../../../ui/common/controls.slint";
import { LineEdit } from "../../../ui/common/line_edit.slint";
import { SettingsTokens, SettingsIcons } from "tokens.slint";
import { SettingsCard, SettingsRow, SettingsDivider, RixButton, RixIconButton } from "card.slint";

export struct AutostartChoice { id: string, name: string, enabled: bool, available: bool, custom: bool }

export global AutostartSettings {
    in-out property <[AutostartChoice]> entries;
    in-out property <[AutostartChoice]> apps;
    in-out property <string> query;
    in-out property <string> error;
    in-out property <bool> picker-open;
    callback search(string);
    callback toggle(string, bool);
    callback add(string);
    callback remove(string);
}

export component AutostartView inherits Rectangle {
    background: transparent;
    preferred-height: content.preferred-height;
    vertical-stretch: 0;

    content := VerticalLayout {
        alignment: start;
        spacing: 16px;

        SettingsCard {
            title: @tr("Startup applications");
            subtitle: @tr("Programs launched automatically on session login");

            HorizontalLayout {
                RixButton {
                    text: AutostartSettings.picker-open ? @tr("Back to list") : @tr("Add application");
                    icon: AutostartSettings.picker-open ? SettingsIcons.close : SettingsIcons.plus;
                    primary: !AutostartSettings.picker-open;
                    clicked => {
                        AutostartSettings.picker-open = !AutostartSettings.picker-open;
                        AutostartSettings.search(AutostartSettings.query);
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            if AutostartSettings.entries.length > 0 && !AutostartSettings.picker-open: SettingsDivider {}

            if !AutostartSettings.picker-open: VerticalLayout {
                spacing: 0px;
                vertical-stretch: 0;
                for app[index] in AutostartSettings.entries: VerticalLayout {
                    spacing: 0px;
                    vertical-stretch: 0;
                    if index > 0: SettingsDivider {}
                    SettingsRow {
                        title: app.name;
                        subtitle: !app.available ? @tr("Application binary not found")
                            : app.custom ? @tr("Custom user entry") : @tr("System entry");
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: center;
                            ToggleSwitch {
                                checked: app.enabled;
                                enabled: app.available || app.enabled;
                                toggled => { AutostartSettings.toggle(app.id, self.checked); }
                            }
                            if app.custom: RixIconButton {
                                icon: SettingsIcons.trash;
                                accessible-name: @tr("Delete");
                                destructive: true;
                                clicked => { AutostartSettings.remove(app.id); }
                            }
                            if !app.custom: RixButton {
                                text: @tr("Disable");
                                enabled: app.enabled;
                                clicked => { AutostartSettings.remove(app.id); }
                            }
                        }
                    }
                }
            }

            if AutostartSettings.entries.length == 0 && !AutostartSettings.picker-open: Text {
                text: @tr("No startup applications configured");
                color: SettingsTokens.text-muted;
                font-size: SettingsTokens.text-md;
            }
        }

        if AutostartSettings.picker-open: SettingsCard {
            title: @tr("Select installed application");

            LineEdit {
                leading-icon: SettingsIcons.search;
                has-icon: true;
                placeholder-text: @tr("Filter applications");
                text <=> AutostartSettings.query;
                edited(value) => { AutostartSettings.search(value); }
            }

            for app[index] in AutostartSettings.apps: VerticalLayout {
                spacing: 0px;
                vertical-stretch: 0;
                if index > 0: SettingsDivider {}
                SettingsRow {
                    title: app.name;
                    RixButton {
                        text: @tr("Add");
                        primary: true;
                        clicked => { AutostartSettings.add(app.id); }
                    }
                }
            }
        }

        if AutostartSettings.error != "": Text {
            text: AutostartSettings.error;
            color: SettingsTokens.danger;
            font-size: SettingsTokens.text-sm;
            wrap: word-wrap;
        }
    }
}
