import { ComboBox } from "../../../ui/common/combo_box.slint";
import { SettingsTokens, SettingsIcons } from "tokens.slint";
import { SettingsCard, SettingsRow } from "card.slint";
import { BehaviorSettings } from "behavior.slint";

export struct LanguageChoice {
    id: string,
    name: string,
    detail: string,
}

export global LanguageSettings {
    in-out property <string> selected: "system";
    in-out property <[LanguageChoice]> choices;
    in-out property <string> status;
    callback choose(string);
}

export component LanguageView inherits Rectangle {
    background: transparent;
    preferred-height: content.preferred-height;
    vertical-stretch: 0;

    content := VerticalLayout {
        alignment: start;
        spacing: 16px;

        SettingsCard {
            title: @tr("Display language");
            subtitle: @tr("Interface language for RixDE and newly launched applications");

            VerticalLayout {
                spacing: 8px;
                for choice in LanguageSettings.choices: Rectangle {
                    min-height: 56px;
                    border-radius: SettingsTokens.radius-md;
                    border-width: 1px;
                    border-color: LanguageSettings.selected == choice.id ? SettingsTokens.accent-border : SettingsTokens.border;
                    background: LanguageSettings.selected == choice.id ? SettingsTokens.bg-raised
                        : touch.has-hover ? SettingsTokens.bg-hover-subtle : SettingsTokens.bg-stage;
                    animate background { duration: SettingsTokens.duration-fast; easing: ease-out; }
                    animate border-color { duration: SettingsTokens.duration-fast; easing: ease-out; }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 12px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: choice.name;
                                color: SettingsTokens.text-primary;
                                font-size: SettingsTokens.text-md;
                                font-weight: 500;
                            }
                            Text {
                                text: choice.detail;
                                color: SettingsTokens.text-secondary;
                                font-size: SettingsTokens.text-sm;
                                wrap: word-wrap;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 0;
                            alignment: center;
                            if LanguageSettings.selected == choice.id: Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 10px;
                                background: SettingsTokens.accent-subtle;
                                Image {
                                    source: SettingsIcons.check;
                                    x: 3px;
                                    y: 3px;
                                    width: 14px;
                                    height: 14px;
                                    colorize: SettingsTokens.accent;
                                    image-fit: contain;
                                }
                            }
                        }
                    }

                    touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { LanguageSettings.choose(choice.id); }
                    }
                }
            }
        }

        SettingsCard {
            title: @tr("Calendar and region");

            SettingsRow {
                title: @tr("First day of the week");
                subtitle: @tr("Starting column in calendar popups");
                ComboBox {
                    model: [@tr("Monday"), @tr("Tuesday"), @tr("Wednesday"), @tr("Thursday"), @tr("Friday"), @tr("Saturday"), @tr("Sunday")];
                    current-index <=> BehaviorSettings.week-start;
                    min-width: 208px;
                }
            }
        }

        if LanguageSettings.status != "": Text {
            text: LanguageSettings.status;
            color: SettingsTokens.text-secondary;
            font-size: SettingsTokens.text-sm;
            wrap: word-wrap;
        }
    }
}
