                width: root.effective-sidebar-width;
                height: parent.height;
                clip: true;
                visible: root.effective-sidebar-width > 0px;
                accessible-role: groupbox; accessible-label: @tr("Places");
                background: root.using-desktop-material ? transparent : Theme.sidebar-background.with-alpha(1);
                VerticalLayout { padding: Theme.spacing-lg; spacing: Theme.default-spacing;
                    HorizontalLayout {
                        height: root.row-height;
                        Text { text: @tr("Places"); color: Theme.text-secondary; font-size: Theme.font-size-sm; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                        IconButton {
                            icon: @image-url("../assets/left.svg");
                            accessible-name: @tr("Collapse sidebar");
                            clicked => { root.sidebar-collapsed = true; root.focus-files(); }
                        }
                    }
                    places-view := ScrollArea {
                        vertical-stretch: 1;
                        min-height: 0px;
                        content-height: places-col.preferred-height;
                        places-col := VerticalLayout {
                            width: places-view.content-width;
                            spacing: 0px;
                            for place[i] in root.places: Rectangle {
                                height: root.row-height + (place.group-start ? Theme.font-size-sm + Theme.spacing-lg * 2 : 0px);
                                if place.group-start: Rectangle { x: Theme.default-spacing; width: parent.width - self.x * 2; height: 1px; y: Theme.spacing-xs; background: root.separator-color; }
                                if place.group-start: Text { x: Theme.default-spacing; y: Theme.default-spacing; width: parent.width - self.x * 2; height: Theme.font-size-sm + Theme.default-spacing; text: @tr("Bookmarks"); color: Theme.text-muted; font-size: Theme.font-size-sm; vertical-alignment: center; }
                                place-row := Rectangle {
                                    accessible-role: button; accessible-label: place.label;
                                    accessible-action-default => { root.open-place(i); root.focus-files(); }
                                    y: place.group-start ? Theme.font-size-sm + Theme.spacing-lg * 2 : 0px; height: root.row-height; width: parent.width;
                                    background: root.drop-hover-place == i || place.active ? Theme.surface-active : place-touch.has-hover ? Theme.surface-hover : transparent;
                                    border-width: root.drop-hover-place == i ? 1px : place-keys.has-focus ? 1px : 0px; border-color: Theme.accent;
                                    border-radius: Theme.radius-sm;
                                    animate background { duration: Theme.hover-duration * 1ms; easing: ease-out; }
                                    if place.active: Rectangle { x: 0px; width: 3px; y: Theme.spacing-xs; height: parent.height - self.y * 2; background: Theme.accent; border-radius: 1.5px; }
                                    Image { x: Theme.default-spacing; y: (parent.height - self.height)/2; source: place.icon; width: Theme.icon-size; height: self.width; image-fit: contain; }
                                    Text { x: Theme.default-spacing * 2 + Theme.icon-size; y: 0px; width: parent.width - self.x - Theme.default-spacing; height: parent.height; text: place.label; color: place.active ? Theme.text-primary : Theme.text-secondary; font-weight: place.active ? 600 : 400; vertical-alignment: center; overflow: elide; font-size: Theme.font-size-md; }
                                    place-keys := FocusScope {
                                        key-pressed(e) => {
                                            if e.text == Key.Return || e.text == " " { root.open-place(i); root.focus-files(); return accept; }
                                            reject
                                        }
                                    }
                                    place-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.open-place(i); root.focus-files(); }
                                        pointer-event(e) => {
                                            if e.kind == PointerEventKind.down {
                                                if e.button == PointerEventButton.right {
                                                    root.menu-place = i;
                                                    root.menu-place-removable = place.removable;
                                                    root.open-menu(3, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                } else if e.button == PointerEventButton.middle {
                                                    root.action-on-place("open-tab", i);
                                                    root.focus-files();
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: root.separator-color; }
                    if root.disks.length == 0: DiskSummary {
                        name: root.disk-name;
                        mount: root.disk-mount;
                        detail: root.disk-detail;
                        usage: root.disk-usage;
                        ratio: root.disk-ratio;
                        ready: root.disk-ready;
                        icon: root.disk-icon;
                        open => { root.open-disk(); root.focus-files(); }
                        context(x, y) => { root.menu-disk = -1; root.open-menu(5, x, y); }
                    }
                    if root.disks.length > 0: VerticalLayout {
                        spacing: Theme.spacing-xs;
                        for disk[di] in root.disks: DiskSummary {
                            name: disk.name;
                            mount: disk.mount;
                            detail: disk.detail;
                            usage: disk.usage;
                            ratio: disk.ratio;
                            ready: disk.ready;
                            icon: disk.icon;
                            open => { root.open-disk-at(di); root.focus-files(); }
                            context(x, y) => { root.menu-disk = di; root.open-menu(5, x, y); }
                        }
                    }
                }
            }
            splitter-line := Rectangle {
                x: root.effective-sidebar-width;
                width: 1px;
                height: parent.height;
                background: splitter-touch.has-hover || splitter-touch.pressed ? Theme.accent : root.separator-color;
                animate background { duration: Theme.hover-duration * 1ms; }
            }
            splitter-touch := TouchArea {
                x: root.effective-sidebar-width - (root.sidebar-collapsed ? 0px : 3px);
                width: root.sidebar-collapsed ? 8px : 7px;
                height: parent.height;
                mouse-cursor: col-resize;
                moved => {
                    if self.pressed {
                        let candidate = root.effective-sidebar-width + (self.mouse-x - (root.sidebar-collapsed ? 0px : 3px));
                        if candidate < 80px {
                            root.sidebar-collapsed = true;
                        } else {
                            root.sidebar-collapsed = false;
                            root.sidebar-width = Math.clamp(candidate, 140px, Math.min(500px, root.width * 0.45));
                        }
                    }
                }
                double-clicked => {
                    root.sidebar-collapsed = !root.sidebar-collapsed;
                    if !root.sidebar-collapsed && root.sidebar-width < 140px {
                        root.sidebar-width = 220px;
                    }
                }
            }
            content := Rectangle {
                x: root.effective-sidebar-width + 1px;
                width: Math.max(0px, parent.width - self.x - (FilePreview.visible && FilePreview.split-mode ? Math.min(460px, parent.width * 0.42) + 1px : 0px));
                height: parent.height;
                background: transparent;
                border-width: root.file-drag-active && root.drop-hover-entry == -1 ? 2px : 0px;
                border-color: Theme.accent;
                border-radius: Theme.radius-sm;
                accessible-role: groupbox; accessible-label: @tr("Folder contents");
                TouchArea { enabled: !root.busy && root.dialog-kind == 0 && root.menu-kind == 0;
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down {
                            if e.button == PointerEventButton.right {
                                root.last-left-entry = -1; root.previous-left-entry = -1;
                                root.folder-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            } else if e.button == PointerEventButton.left {
                                root.begin-file-gesture(-1, self.absolute-position.x + self.mouse-x - file-area.absolute-position.x,
                                    self.absolute-position.y + self.mouse-y - file-area.absolute-position.y, e.modifiers.control, e.modifiers.shift);
                            } else if e.button == PointerEventButton.back {
                                root.run("back");
                            } else if e.button == PointerEventButton.forward {
                                root.run("forward");
                            }
                        } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left { root.end-file-gesture(); }
                        else if e.kind == PointerEventKind.cancel { root.cancel-file-gesture(); }
                    }
                    moved => { root.move-file-gesture(self.absolute-position.x + self.mouse-x - file-area.absolute-position.x,
                        self.absolute-position.y + self.mouse-y - file-area.absolute-position.y); }
                    scroll-event(e) => { reject }
                }
                VerticalLayout { padding: Theme.spacing-xl; spacing: Theme.default-spacing;
                    if !root.grid-view: Rectangle {
                        height: Theme.icon-size + Theme.spacing-xs * 2;
                        private property <length> row-w: list.content-width;
                        private property <length> type-x: self.row-w - Theme.default-spacing - root.type-column;
                        private property <length> mod-x: self.row-w - Theme.default-spacing - (root.show-type ? root.type-column + Theme.default-spacing : 0px) - root.modified-column;
                        private property <length> size-x: self.mod-x - Theme.default-spacing - root.size-column;
                        private property <length> name-x: Theme.default-spacing * 2 + Theme.icon-size-lg;
                        Rectangle {
                            x: parent.name-x - Theme.spacing-xs;
                            width: Math.max(0px, parent.size-x - parent.name-x);
                            height: parent.height; border-radius: Theme.radius-sm;
                            background: h-name.has-hover ? Theme.surface-hover : transparent;
                            accessible-role: button; accessible-label: @tr("Name");
                            accessible-action-default => { root.run("sort-name"); }
                            Text { x: Theme.spacing-xs; width: parent.width - Theme.spacing-xs * 2; height: parent.height; text: @tr("Name") + (root.sort-mode == 0 ? (root.sort-descending ? " ▼" : " ▲") : ""); color: root.sort-mode == 0 ? Theme.text-primary : Theme.text-secondary; font-size: Theme.font-size-sm; font-weight: root.sort-mode == 0 ? 600 : 500; vertical-alignment: center; overflow: elide; }
                            h-name := TouchArea { mouse-cursor: pointer; clicked => { root.run("sort-name"); } }
                        }
                        Rectangle {
                            x: parent.size-x; width: root.size-column + Theme.spacing-xs;
                            height: parent.height; border-radius: Theme.radius-sm;
                            background: h-size.has-hover ? Theme.surface-hover : transparent;
                            accessible-role: button; accessible-label: @tr("Size");
                            accessible-action-default => { root.run("sort-size"); }
                            Text { x: 0px; width: root.size-column; height: parent.height; text: (root.sort-mode == 1 ? (root.sort-descending ? "▼ " : "▲ ") : "") + @tr("Size"); color: root.sort-mode == 1 ? Theme.text-primary : Theme.text-secondary; font-size: Theme.font-size-sm; font-weight: root.sort-mode == 1 ? 600 : 500; horizontal-alignment: right; vertical-alignment: center; }
                            h-size := TouchArea { mouse-cursor: pointer; clicked => { root.run("sort-size"); } }
                        }
                        Rectangle {
                            x: parent.mod-x - Theme.spacing-xs; width: root.modified-column + Theme.spacing-xs * 2;
                            height: parent.height; border-radius: Theme.radius-sm;
                            background: h-mod.has-hover ? Theme.surface-hover : transparent;
                            accessible-role: button; accessible-label: @tr("Modified");
                            accessible-action-default => { root.run("sort-modified"); }
                            Text { x: Theme.spacing-xs; width: root.modified-column; height: parent.height; text: @tr("Modified") + (root.sort-mode == 2 ? (root.sort-descending ? " ▼" : " ▲") : ""); color: root.sort-mode == 2 ? Theme.text-primary : Theme.text-secondary; font-size: Theme.font-size-sm; font-weight: root.sort-mode == 2 ? 600 : 500; vertical-alignment: center; }
                            h-mod := TouchArea { mouse-cursor: pointer; clicked => { root.run("sort-modified"); } }
                        }
                        if root.show-type: Rectangle {
                            x: parent.type-x - Theme.spacing-xs; width: root.type-column + Theme.spacing-xs * 2;
                            height: parent.height; border-radius: Theme.radius-sm;
                            background: h-type.has-hover ? Theme.surface-hover : transparent;
                            accessible-role: button; accessible-label: @tr("Type");
                            accessible-action-default => { root.run("sort-kind"); }
                            Text { x: Theme.spacing-xs; width: root.type-column; height: parent.height; text: @tr("Type") + (root.sort-mode == 3 ? (root.sort-descending ? " ▼" : " ▲") : ""); color: root.sort-mode == 3 ? Theme.text-primary : Theme.text-secondary; font-size: Theme.font-size-sm; font-weight: root.sort-mode == 3 ? 600 : 500; vertical-alignment: center; overflow: elide; }
                            h-type := TouchArea { mouse-cursor: pointer; clicked => { root.run("sort-kind"); } }
                        }
                        Rectangle { y: parent.height - 1px; width: parent.row-w; height: 1px; background: root.separator-color; }
                    }
                    file-area := Rectangle { vertical-stretch: 1; clip: true;
                        list := VirtualScrollArea {
                            visible: !root.grid-view;
                            width: parent.width; height: parent.height;
                            content-height: root.entries.length * root.row-height + root.row-height;
                            changed viewport-y => {
                                root.hovered-entry = root.entry-at(root.pointer-x, root.pointer-y);
                                root.scroll-changed();
                            }
                            VerticalLayout {
                                width: list.content-width;
                                spacing: 0px;
                                for entry[i] in root.entries: FileCell { height: root.row-height; item: entry; hovered: root.hovered-entry == i; drop-target: root.drop-hover-entry == i;
                                    show-type: root.show-type; size-column: root.size-column; modified-column: root.modified-column; type-column: root.type-column;
                                    selected(ctrl,shift) => { root.select-entry(i,ctrl,shift); root.focus-files(); }
                                    activated => { root.activate-entry(i); }
                                    context(x,y) => { root.file-menu(i,x,y); }
                                }
                            }
                        }
                        grid := VirtualScrollArea {
                            visible: root.grid-view;
                            width: parent.width; height: parent.height;
                            content-height: root.grid-rows.length * (root.grid-cell-size + root.grid-gap) + root.row-height;
                            changed viewport-y => {
                                root.hovered-entry = root.entry-at(root.pointer-x, root.pointer-y);
                                root.scroll-changed();
                            }
                            VerticalLayout {
                                width: grid.content-width;
                                spacing: 0px;
                                for row in root.grid-rows: Rectangle { height: root.grid-cell-size + root.grid-gap;
                                    for entry[i] in row.items: FileCell { x: i * (root.grid-cell-size + root.grid-gap); y: 0px; width: root.grid-cell-size; height: self.width; item: entry; grid: true; grid-icon-size: root.grid-icon-size; hovered: root.hovered-entry == row.start + i; drop-target: root.drop-hover-entry == row.start + i;
                                        selected(ctrl,shift) => { root.select-entry(row.start + i,ctrl,shift); root.focus-files(); }
                                        activated => { root.activate-entry(row.start + i); }
                                        context(x,y) => { root.file-menu(row.start+i,x,y); }
                                    }
                                }
                            }
                        }
                        file-input := TouchArea {
                            x: 0px; y: 0px;
                            width: parent.width - Theme.scrollbar-gutter; height: parent.height;
                            enabled: root.dialog-kind == 0 && root.menu-kind == 0;
                            mouse-cursor: root.hovered-entry >= 0 ? pointer : default;
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.down {
                                    let index = root.entry-at(self.mouse-x, self.mouse-y);
                                    root.pressed-entry = index;
                                    if e.button == PointerEventButton.right {
                                        root.last-left-entry = -1; root.previous-left-entry = -1;
                                        if index >= 0 { root.file-menu(index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                                        else { root.folder-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                                    } else if e.button == PointerEventButton.left {
                                        root.begin-file-gesture(index, self.mouse-x, self.mouse-y, e.modifiers.control, e.modifiers.shift);
                                    } else if e.button == PointerEventButton.middle && index >= 0 && index < root.entries.length && root.entries[index].is-dir && !root.trash-view {
                                        root.action-on-entry("open-tab", index);
                                    } else if e.button == PointerEventButton.back {
                                        root.run("back");
                                    } else if e.button == PointerEventButton.forward {
                                        root.run("forward");
                                    }
                                } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                                    root.end-file-gesture();
                                } else if e.kind == PointerEventKind.cancel { root.cancel-file-gesture(); }
                            }
                            moved => { root.move-file-gesture(self.mouse-x, self.mouse-y); }
                            changed has-hover => { if !self.has-hover { root.hovered-entry = -1; } }
                            double-clicked => { if !root.drag-threshold-crossed && !root.press-control && !root.press-shift && root.pressed-entry >= 0 && root.pressed-entry == root.previous-left-entry { root.activate-entry(root.pressed-entry); } }
