                                }
                                reject
                            }
                        }
                        if root.rectangle-visible: Rectangle {
                            x: Math.max(0px, Math.min(root.press-x, root.pointer-x));
                            y: Math.max(0px, Math.min(root.press-content-y + root.content-offset, root.pointer-y));
                            width: Math.max(1px, Math.min(file-input.width, Math.max(root.press-x, root.pointer-x)) - self.x);
                            height: Math.max(1px, Math.min(file-input.height, Math.max(root.press-content-y + root.content-offset, root.pointer-y)) - self.y);
                            background: Theme.accent.with-alpha(0.15); border-width: 1px; border-color: Theme.accent; border-radius: 2px;
                        }
                        Timer {
                            interval: 40ms; running: (root.pointer-held && root.rectangle-visible) || root.file-drag-active;
                            triggered => {
                                let movement = root.pointer-y < 24px ? 12px : root.pointer-y > file-area.height - 24px ? -12px : 0px;
                                if movement != 0px {
                                    if root.grid-view { grid.scroll-by(movement); }
                                    else { list.scroll-by(movement); }
                                    if root.rectangle-visible { root.update-selection-rectangle(); }
                                }
                            }
                        }
                        if root.entries.length == 0 || root.busy: Text { text: root.busy ? @tr("Loading…") : root.empty-message; color: Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
                    }
                }
            }
            if FilePreview.visible && FilePreview.split-mode: Rectangle {
                x: content.x + content.width;
                width: 1px;
                height: parent.height;
                background: root.separator-color;
            }
            if FilePreview.visible && FilePreview.split-mode: PreviewPanel {
                x: content.x + content.width + 1px;
                width: Math.max(0px, parent.width - self.x);
                height: parent.height;
                desktop-material: root.using-desktop-material;
            }
        }
        if FilePicker.active: PickerBar { using-desktop-material: root.using-desktop-material; }
        if root.notice-text != "": Rectangle {
            height: Theme.icon-size + Theme.default-spacing * 2;
            background: root.using-desktop-material ? transparent : (root.notice-error ? Theme.danger-bg : Theme.control-surface);
            Rectangle { x: 0px; y: 0px; height: 1px; width: parent.width; background: root.notice-error ? Theme.danger : root.separator-color; }
            HorizontalLayout {
                padding-left: Theme.spacing-xl; padding-right: Theme.spacing-lg;
                spacing: Theme.default-spacing;
                Text {
                    text: root.notice-text;
                    color: root.notice-error ? Theme.danger : Theme.text-primary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if root.can-undo && !root.operation-active && !root.notice-error: Button {
                    text: @tr("Undo");
                    clicked => { root.dismiss-notice(); root.run("undo"); }
                }
                IconButton {
                    icon: @image-url("../assets/close.svg");
                    accessible-name: @tr("Dismiss notice");
                    clicked => { root.dismiss-notice(); }
                }
            }
        }
        if root.operation-active: Rectangle { height: root.row-height + Theme.default-spacing * 2; background: root.using-desktop-material ? transparent : Theme.control-surface;
            Rectangle { x: 0px; y: 0px; height: 1px; width: parent.width; background: root.separator-color; }
            HorizontalLayout { padding: Theme.default-spacing; spacing: Theme.default-spacing;
                Text { text: root.operation-message; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                Rectangle { width: Theme.font-size-md * 14; height: Theme.spacing-xs; background: Theme.control-border; border-radius: Theme.radius-sm;
                    Rectangle { width: parent.width * Math.clamp(root.operation-progress,0,1); height: parent.height; background: Theme.accent; border-radius: Theme.radius-sm; }
                }
                Button { text: @tr("Cancel"); clicked => { root.run("cancel-operation"); } }
            }
        }
        if !FilePicker.active: Rectangle { height: Theme.font-size-sm + Theme.default-spacing * 2; background: root.using-desktop-material ? transparent : Theme.sidebar-background.with-alpha(1);
            Rectangle { x: 0px; y: 0px; height: 1px; width: parent.width; background: root.separator-color; }
            Text { x: Theme.spacing-xl; width: parent.width - self.x * 2; height: parent.height; text: root.status; color: Theme.text-secondary; font-size: Theme.font-size-sm; vertical-alignment: center; overflow: elide; }
        }
    }
    if root.menu-kind > 0: TouchArea {
        pointer-event(e) => { if e.kind == PointerEventKind.down { root.menu-kind = 0; root.focus-files(); } }
    }

    actions-menu := ActionsMenu { visible: root.menu-kind > 0; open: root.menu-kind > 0;
        opacity: root.native-popup-active ? 0 : 1;
        next-index(current,direction) => { root.next-menu-index(self.items, current, direction) }
        rows-height(items, row-height, separator-height) => { root.menu-rows-height(items, row-height, separator-height) }
        items-width(items, font-size, min-width) => { root.menu-items-width(items, font-size, min-width) }
        anchor-x: root.menu-x; anchor-y: root.menu-y; window-width: root.width; window-height: root.height; prefer-before: root.menu-kind == 4;
        accessible-name: root.menu-kind == 1 ? @tr("File actions") : root.menu-kind == 2 ? @tr("Folder actions") : root.menu-kind == 3 ? @tr("Place actions") : root.menu-kind == 5 ? @tr("Disk actions") : root.menu-kind == 6 ? @tr("Tab actions") : @tr("Options");
        items: root.menu-kind == 1 ? root.file-actions : root.menu-kind == 2 ? root.folder-actions : root.menu-kind == 3 ? root.place-actions : root.menu-kind == 5 ? root.disk-actions : root.menu-kind == 6 ? root.tab-actions : root.options-actions;
        activated(action) => { root.activate-menu(action); }
        dismissed => { root.dismiss-menu(); }
    }
    }
    if root.tooltip-text != "" && root.menu-kind == 0 && root.dialog-kind == 0: Rectangle {
        x: Math.clamp(root.tooltip-x - self.width / 2, Theme.spacing-xs, Math.max(Theme.spacing-xs, root.width - self.width - Theme.spacing-xs));
        y: Math.min(root.tooltip-y, root.height - self.height - Theme.spacing-xs);
        width: tt-lbl.preferred-width + Theme.spacing-lg * 1.5;
        height: Theme.font-size-sm + Theme.default-spacing * 1.5;
        border-radius: Theme.radius-sm;
        background: Theme.menu-bg.with-alpha(0.96);
        border-width: 1px;
        border-color: Theme.border-highlight;
        tt-lbl := Text {
            width: parent.width; height: parent.height;
            text: root.tooltip-text;
            color: Theme.text-primary;
            font-size: Theme.font-size-sm;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if ArchiveBrowser.visible && (!FilePreview.visible || FilePreview.split-mode): ArchivePanel { width: root.width; height: root.height; desktop-material: root.using-desktop-material; init => { self.focus-browser(); } }
    if FilePreview.visible && !FilePreview.split-mode: PreviewPanel { width: root.width; height: root.height; desktop-material: root.using-desktop-material; }
    Rectangle {
        visible: root.dialog-kind > 0;
        width: root.width; height: root.height;
        private property <bool> quick-popover: root.dialog-kind == 1 || root.dialog-kind == 2 || root.dialog-kind == 6;
        Rectangle {
            width: parent.width; height: parent.height;
            background: parent.quick-popover ? transparent : Theme.shadow.with-alpha(0.24);
        }
        TouchArea {
            clicked => { root.dismiss-dialog(); }
        }
        if root.dialog-kind == 5 && root.using-desktop-material && DialogBackdrop.ready: Rectangle {
            x: application-chooser.x; y: application-chooser.y;
            width: application-chooser.width; height: application-chooser.height;
            border-radius: Theme.radius-md; clip: true;
            Image {
                x: -application-chooser.x; y: -application-chooser.y;
                width: root.width; height: root.height;
                source: DialogBackdrop.image; image-fit: fill;
            }
        }
        application-chooser := ApplicationChooserPanel {
            blur-local-content: true;
            visible: root.dialog-kind == 5;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: Math.min(620px, parent.width - Theme.spacing-xl * 3);
            height: Math.min(560px, parent.height - Theme.spacing-xl * 2);
            desktop-material: root.using-desktop-material;
        }
        if root.dialog-kind == 10 && root.using-desktop-material && DialogBackdrop.ready: Rectangle {
            x: properties-panel.x;
            y: properties-panel.y;
            width: properties-panel.width;
            height: properties-panel.height;
            border-radius: Theme.radius-md;
            clip: true;
            Image {
                x: -properties-panel.x;
                y: -properties-panel.y;
                width: root.width;
                height: root.height;
                source: DialogBackdrop.image;
                image-fit: fill;
            }
        }
        properties-panel := PropertiesPanel {
            blur-local-content: true;
            visible: root.dialog-kind == 10;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: Math.min(460px, parent.width - Theme.spacing-xl * 2);
            height: Math.min(560px, parent.height - Theme.spacing-xl * 2);
            material-supported: root.using-desktop-material;
            opaque: !root.using-desktop-material;
            dismissed => { root.dismiss-dialog(); }
        }
        if root.dialog-kind != 5 && root.dialog-kind != 10 && root.using-desktop-material && DialogBackdrop.ready: Rectangle {
            x: modal-card.x + 2px; y: modal-card.y + 2px;
            width: Math.max(0px, modal-card.width - 4px); height: Math.max(0px, modal-card.height - 4px);
            border-radius: Theme.radius-md; clip: true;
            Image {
                x: -(modal-card.x + 2px); y: -(modal-card.y + 2px);
                width: root.width; height: root.height;
                source: DialogBackdrop.image; image-fit: fill;
            }
        }
        dialog-keys := FocusScope {
            width: parent.width; height: parent.height;
            visible: root.dialog-kind != 5 && root.dialog-kind != 10;
            enabled: root.dialog-kind > 0 && root.dialog-kind != 5 && root.dialog-kind != 10;
            key-pressed(e) => {
                if e.text == Key.Escape { root.dismiss-dialog(); return accept; }
                if e.text == Key.Tab || e.text == Key.Backtab {
                    let backwards = e.modifiers.shift || e.text == Key.Backtab;
                    if root.dialog-kind == 1 || root.dialog-kind == 2 || root.dialog-kind == 6 || root.dialog-kind == 9 {
                        if dialog-field.has-focus {
                            if backwards { dialog-confirm.focus-button(); } else { dialog-cancel.focus-button(); }
                        } else if dialog-cancel.has-focus {
                            if backwards { dialog-field.focus-input(); } else { dialog-confirm.focus-button(); }
                        } else {
                            if backwards { dialog-cancel.focus-button(); } else { dialog-field.focus-input(); }
                        }
                    } else if root.dialog-kind == 3 || root.dialog-kind == 8 {
                        if dialog-cancel.has-focus { dialog-confirm.focus-button(); } else { dialog-cancel.focus-button(); }
                    } else {
                        dialog-cancel.focus-button();
                    }
                    return accept;
                }
                if e.text == Key.Return {
                    if root.dialog-kind == 3 || root.dialog-kind == 11 {
                        if dialog-confirm.has-focus && root.dialog-kind == 3 { root.confirm-dialog(root.dialog-value); }
                        else { root.dismiss-dialog(); }
                    } else if root.dialog-kind < 4 || root.dialog-kind == 6 || root.dialog-kind == 8 || root.dialog-kind == 9 { root.confirm-dialog(root.dialog-value); }
                    else { root.dismiss-dialog(); }
                    return accept;
                }

                if e.modifiers.control || e.modifiers.alt { return accept; }
                reject
            }
            modal-card := MenuSurface {
                private property <bool> quick: root.dialog-kind == 1 || root.dialog-kind == 2 || root.dialog-kind == 6;
                private property <bool> danger-dialog: root.dialog-kind == 3 || root.dialog-kind == 4;
                private property <bool> show-message: root.dialog-text != "" && !self.quick;
                x: self.quick
                    ? Math.clamp(root.effective-sidebar-width + (root.width - root.effective-sidebar-width - self.width) / 2, Theme.spacing-lg, Math.max(Theme.spacing-lg, root.width - self.width - Theme.spacing-lg))
                    : (parent.width - self.width) / 2;
                y: self.quick
                    ? Math.min(Math.max(Theme.spacing-lg, chrome.height + Theme.spacing-lg), Math.max(Theme.spacing-lg, parent.height - self.height - Theme.spacing-lg))
                    : (parent.height - self.height) / 2;
                width: Math.max(0px, Math.min(self.quick ? 420px : 440px, parent.width - Theme.spacing-xl * 2));
                height: Math.max(0px, Math.min(parent.height - Theme.spacing-xl * 2, dialog-content.preferred-height));
                surface-radius: Theme.radius-md;
                blur-local-content: true;
                material-supported: root.using-desktop-material;
                opaque: !root.using-desktop-material;
                TouchArea {}
                dialog-content := VerticalLayout {
                    padding: Theme.spacing-lg + 4px;
                    spacing: Theme.spacing-lg;
                    HorizontalLayout {
                        spacing: Theme.spacing-lg;
                        alignment: space-between;
                        HorizontalLayout {
                            spacing: Theme.default-spacing + 2px;
                            horizontal-stretch: 1;
                            Rectangle {
                                width: 32px; height: 32px;
                                vertical-stretch: 0; horizontal-stretch: 0;
                                border-radius: Theme.radius-sm;
                                background: modal-card.danger-dialog ? Theme.danger-bg : Theme.control-surface;
                                border-width: 1px;
                                border-color: modal-card.danger-dialog ? Theme.danger.with-alpha(0.35) : Theme.control-border;
                                Image {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: 18px; height: 18px;
                                    source: root.dialog-kind == 3 ? @image-url("../assets/trash.svg")
                                        : (root.dialog-kind == 4 || root.dialog-kind == 8 || root.dialog-kind == 11) ? @image-url("../assets/warning.svg")
                                        : Icons.folder;
                                    colorize: modal-card.danger-dialog ? Theme.danger : Theme.accent;
                                    image-fit: contain;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.dialog-title;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-size-lg;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        IconButton {
                            icon: @image-url("../assets/close.svg");
                            accessible-name: @tr("Close dialog");
                            clicked => { root.dismiss-dialog(); }
                        }
                    }
                    if modal-card.show-message: message-scroll := ScrollArea {
                        min-height: 0px;
                        preferred-height: Math.min(Theme.font-size-md * 8, message.preferred-height);
                        max-height: 65535px;
                        vertical-stretch: 1;
                        content-height: message.preferred-height;
                        message := Text {
                            width: message-scroll.content-width;
                            text: root.dialog-text;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-md;
                            wrap: word-wrap;
                        }
                    }
                    if root.dialog-error != "": Text { text: root.dialog-error; color: Theme.danger; font-size: Theme.font-size-sm; wrap: word-wrap; }
                    dialog-field := Field {
                        visible: root.dialog-kind == 1 || root.dialog-kind == 2 || root.dialog-kind == 6 || root.dialog-kind == 9;
                        min-height: self.visible ? Theme.icon-size + Theme.default-spacing * 2 : 0px;
                        preferred-height: self.min-height;
                        max-height: self.min-height;
                        placeholder: root.dialog-title;
                        text <=> root.dialog-value;
                        accepted(value) => { root.confirm-dialog(value); }
                        escape => { root.dismiss-dialog(); }
                    }
                    if root.dialog-kind == 11: HorizontalLayout {
                        spacing: Theme.default-spacing;
                        ToggleSwitch { checked <=> root.dialog-apply-all; }
                        Text { text: @tr("Apply to all conflicts"); color: Theme.text-secondary; font-size: Theme.font-size-sm; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                    if !modal-card.quick: Rectangle { height: 1px; background: Theme.border; }
                    dialog-footer := HorizontalLayout {
                        private property <bool> confirming: root.dialog-kind < 4 || root.dialog-kind == 6 || root.dialog-kind == 8 || root.dialog-kind == 9;
                        alignment: end;
                        spacing: Theme.default-spacing;
                        dialog-cancel := Button {
                            text: root.dialog-kind == 4 ? @tr("Close") : root.dialog-kind == 11 ? @tr("Skip") : @tr("Cancel");
                            active: root.dialog-kind == 4;
                            clicked => {
                                if root.dialog-kind == 11 { root.resolve-conflict("skip", root.dialog-apply-all); }
                                else { root.dismiss-dialog(); }
                            }
                        }
                        if root.dialog-kind == 11: Button {
                            text: @tr("Keep both");
                            active: true;
                            clicked => { root.resolve-conflict("keep-both", root.dialog-apply-all); }
                        }
                        if root.dialog-kind == 11: Button {
                            text: @tr("Replace");
                            destructive: true;
                            active: true;
                            clicked => { root.resolve-conflict("replace", root.dialog-apply-all); }
                        }
                        dialog-confirm := Button {
                            visible: dialog-footer.confirming;
                            text: root.dialog-kind == 3 ? @tr("Delete permanently") : root.dialog-kind == 1 || root.dialog-kind == 6 ? @tr("Create") : root.dialog-kind == 2 ? @tr("Rename") : @tr("Confirm");
                            destructive: root.dialog-kind == 3 || root.dialog-kind == 8;
                            active: true;
                            clicked => { root.confirm-dialog(root.dialog-value); }
                        }
                    }
                }
            }
        }
    }
}
