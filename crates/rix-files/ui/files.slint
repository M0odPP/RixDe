        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, checkable: false, radio: false, destructive: false},
        {action: "cut", label: @tr("Cut"), shortcut: "Ctrl+X", enabled: !root.trash-view, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "copy", label: @tr("Copy"), shortcut: "Ctrl+C", enabled: true, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "duplicate", label: @tr("Duplicate"), shortcut: "Ctrl+D", enabled: root.selection-count > 0 && !root.trash-view && !root.operation-active, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "paste", label: @tr("Paste"), shortcut: "Ctrl+V", enabled: root.paste-available && !root.operation-active && !root.trash-view, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "copy-path", label: @tr("Copy path"), enabled: root.selection-count > 0 && !root.trash-view, shortcut: "Ctrl+Shift+C", checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, checkable: false, radio: false, destructive: false},
        {action: "rename", label: @tr("Rename…"), shortcut: "F2", enabled: root.selection-count == 1 && !root.operation-active && !root.trash-view, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: root.trash-view ? "restore" : "trash", label: root.trash-view ? @tr("Restore") : @tr("Move to trash"), shortcut: root.trash-view ? "" : "Del", enabled: !root.operation-active, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "delete", label: @tr("Delete permanently…"), shortcut: root.trash-view ? "Del" : "Shift+Del", destructive: true, enabled: !root.operation-active, checked: false, checkable: false, radio: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, checkable: false, radio: false, destructive: false},
        {action: "properties", label: @tr("Properties"), shortcut: "Alt+Enter", enabled: true, checked: false, checkable: false, radio: false, destructive: false, separator: false}
    ];
    private property <[MenuItem]> folder-actions: [
        {action: "new-folder", label: @tr("New folder"), shortcut: "Ctrl+Shift+N", enabled: !root.trash-view && !root.operation-active, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "new-file", label: @tr("New file"), shortcut: "Ctrl+Alt+N", enabled: !root.trash-view && !root.operation-active, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "paste", label: @tr("Paste"), shortcut: "Ctrl+V", enabled: root.paste-available && !root.operation-active && !root.trash-view, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, checkable: false, radio: false, destructive: false},
        {action: "terminal", label: @tr("Open terminal here"), enabled: !root.trash-view, shortcut: "", checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "bookmark", label: @tr("Bookmark folder"), enabled: !root.trash-view, shortcut: "", checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, checkable: false, radio: false, destructive: false},
        {action: "refresh", label: @tr("Refresh"), shortcut: "F5", enabled: true, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "hidden", label: @tr("Show hidden files"), shortcut: "Ctrl+H", checked: root.show-hidden, checkable: true, radio: false, enabled: true, destructive: false, separator: false},
        {action: "undo", label: @tr("Undo"), shortcut: "Ctrl+Z", enabled: root.can-undo && !root.operation-active, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "redo", label: @tr("Redo"), shortcut: "Ctrl+Shift+Z", enabled: root.can-redo && !root.operation-active, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, checkable: false, radio: false, destructive: false},
        {action: "folder-properties", label: @tr("Properties"), shortcut: "Alt+Enter", enabled: true, checked: false, checkable: false, radio: false, destructive: false, separator: false}
    ];
    private property <[MenuItem]> place-actions: [
        {action: "open-place", label: @tr("Open"), shortcut: "", enabled: true, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "open-place-tab", label: @tr("Open in new tab"), shortcut: "", enabled: root.tabs.length < 12, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "place-terminal", label: @tr("Open terminal here"), shortcut: "", enabled: true, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "copy-place-path", label: @tr("Copy path"), shortcut: "", enabled: true, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, checkable: false, radio: false, destructive: false},
        {action: "place-properties", label: @tr("Properties"), shortcut: "", enabled: true, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "unpin", label: @tr("Unpin from Places"), shortcut: "", enabled: root.menu-place-removable, checked: false, checkable: false, radio: false, destructive: false, separator: false}
    ];
    private property <[MenuItem]> disk-actions: [
        {action: "open-disk", label: @tr("Open"), shortcut: "Enter", enabled: true, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "open-disk-tab", label: @tr("Open in new tab"), shortcut: "Ctrl+T", enabled: true, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "disk-terminal", label: @tr("Open terminal here"), shortcut: "", enabled: true, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "copy-disk-path", label: @tr("Copy mount path"), shortcut: "Ctrl+Shift+C", enabled: true, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, checkable: false, radio: false, destructive: false},
        {action: "disk-properties", label: @tr("Properties"), shortcut: "Alt+Enter", enabled: true, checked: false, checkable: false, radio: false, destructive: false, separator: false}
    ];
    private property <[MenuItem]> tab-actions: [
        {action: "close-tab-menu", label: @tr("Close tab"), shortcut: "Ctrl+W", enabled: root.tabs.length > 1, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "close-other-tabs", label: @tr("Close other tabs"), shortcut: "", enabled: root.tabs.length > 1, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "close-tabs-right", label: @tr("Close tabs to the right"), shortcut: "", enabled: root.menu-tab >= 0 && root.menu-tab < root.tabs.length - 1, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, checkable: false, radio: false, destructive: false},
        {action: "duplicate-tab", label: @tr("Duplicate tab"), shortcut: "", enabled: root.tabs.length < 12, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "copy-tab-path", label: @tr("Copy path"), shortcut: "Ctrl+Shift+C", enabled: true, checked: false, checkable: false, radio: false, destructive: false, separator: false}
    ];
    private property <[MenuItem]> options-actions: [
        {action: "new-folder", label: @tr("New folder"), shortcut: "Ctrl+Shift+N", enabled: !root.trash-view && !root.operation-active, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "new-file", label: @tr("New file"), shortcut: "Ctrl+Alt+N", enabled: !root.trash-view && !root.operation-active, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "paste", label: @tr("Paste"), shortcut: "Ctrl+V", enabled: root.paste-available && !root.operation-active && !root.trash-view, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "select-all", label: @tr("Select all"), shortcut: "Ctrl+A", enabled: root.entries.length > 0, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, checkable: false, radio: false, destructive: false},
        {action: "undo", label: @tr("Undo"), shortcut: "Ctrl+Z", enabled: root.can-undo && !root.operation-active, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "redo", label: @tr("Redo"), shortcut: "Ctrl+Shift+Z", enabled: root.can-redo && !root.operation-active, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, checkable: false, radio: false, destructive: false},
        {action: "hidden", label: @tr("Show hidden files"), shortcut: "Ctrl+H", checked: root.show-hidden, checkable: true, radio: false, enabled: true, destructive: false, separator: false},
        {action: "toggle-search-recursive", label: @tr("Search subfolders"), shortcut: "", checked: root.search-recursive, checkable: true, radio: false, enabled: true, destructive: false, separator: false},
        {action: "refresh", label: @tr("Refresh"), shortcut: "F5", enabled: true, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, checkable: false, radio: false, destructive: false},
        {action: "sort-name", label: @tr("Name"), enabled: true, shortcut: "", checked: root.sort-mode == 0, checkable: true, radio: true, destructive: false, separator: false},
        {action: "sort-size", label: @tr("Size"), enabled: true, shortcut: "", checked: root.sort-mode == 1, checkable: true, radio: true, destructive: false, separator: false},
        {action: "sort-modified", label: @tr("Modified"), enabled: true, shortcut: "", checked: root.sort-mode == 2, checkable: true, radio: true, destructive: false, separator: false},
        {action: "sort-kind", label: @tr("Type"), enabled: true, shortcut: "", checked: root.sort-mode == 3, checkable: true, radio: true, destructive: false, separator: false},
        {action: "sort-order", label: @tr("Descending"), enabled: true, shortcut: "", checked: root.sort-descending, checkable: true, radio: false, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, checkable: false, radio: false, destructive: false},
        {action: "grid-small", label: @tr("Small icons"), enabled: root.grid-view, shortcut: "", checked: root.grid-size == 0, checkable: true, radio: true, destructive: false, separator: false},
        {action: "grid-medium", label: @tr("Medium icons"), enabled: root.grid-view, shortcut: "", checked: root.grid-size == 1, checkable: true, radio: true, destructive: false, separator: false},
        {action: "grid-large", label: @tr("Large icons"), enabled: root.grid-view, shortcut: "", checked: root.grid-size == 2, checkable: true, radio: true, destructive: false, separator: false},
        {separator: true, action: "", label: "", shortcut: "", enabled: false, checked: false, checkable: false, radio: false, destructive: false},
        {action: "folder-properties", label: @tr("Folder properties"), shortcut: "", enabled: true, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "restore-places", label: @tr("Restore default Places"), enabled: true, shortcut: "", checked: false, checkable: false, radio: false, destructive: false, separator: false}
    ];
    callback next-menu-index([MenuItem], int, int) -> int;
    pure callback menu-rows-height([MenuItem], length, length) -> length;
    pure callback menu-items-width([MenuItem], length, length) -> length;
    callback show-native-menu([MenuItem], string, length, length, length, length) -> bool;
    callback close-native-menu();
    callback navigate(string);
    callback action(string);
    callback select-entry(int, bool, bool);
    callback begin-file-drag(int) -> bool;
    callback begin-rectangle(bool, bool);
    callback update-rectangle(float, float, float, float, float, float, float, int);
    callback finish-rectangle(bool);
    pure callback place-at([PlaceItem], length, length, length) -> int;
    callback activate-entry(int);
    callback switch-tab(int);
    callback close-tab(int);
    callback open-place(int);
    callback unpin-place(int);
    callback grid-columns-changed(int);
    callback search-changed(string);
    callback confirm-dialog(string);
    callback dismiss-dialog();
    callback context-entry(int);
    callback keyboard(string, bool, bool, bool);
    callback control-key-in-field(string, bool, bool) -> bool;
    callback dismiss-notice();
    callback resolve-conflict(string, bool);
    callback scroll-changed();
    callback choose-application(int);
    public function focus-files() {
        if FilePreview.visible && !FilePreview.split-mode { FilePreview.focus-generation += 1; }
        else if ArchiveBrowser.visible { ArchiveBrowser.focus-generation += 1; }
        else { files-keys.focus(); }
    }
    public function focus-inline-menu() { actions-menu.focus-menu(); }
    public function dismiss-menu() { root.menu-kind = 0; root.native-popup-active = false; root.focus-files(); }
    public function activate-menu(action: string) {
        if action == "unpin" { root.menu-kind = 0; root.unpin-place(root.menu-place); root.focus-files(); }
        else if action == "open-place" { root.menu-kind = 0; root.open-place(root.menu-place); root.focus-files(); }
        else if action == "open-place-tab" { root.menu-kind = 0; root.action-on-place("open-tab", root.menu-place); root.focus-files(); }
        else if action == "place-terminal" { root.menu-kind = 0; root.action-on-place("terminal", root.menu-place); root.focus-files(); }
        else if action == "copy-place-path" { root.menu-kind = 0; root.action-on-place("copy-path", root.menu-place); root.focus-files(); }
        else if action == "place-properties" { root.menu-kind = 0; root.action-on-place("properties", root.menu-place); root.focus-files(); }
        else if action == "open-disk" { root.menu-kind = 0; if root.menu-disk >= 0 && root.disks.length > 0 { root.open-disk-at(root.menu-disk); } else { root.open-disk(); } root.focus-files(); }
        else if action == "open-disk-tab" { root.menu-kind = 0; if root.menu-disk >= 0 && root.disks.length > 0 { root.action-on-disk("open-tab", root.menu-disk); } else { root.action("open-disk-tab"); } root.focus-files(); }
        else if action == "disk-terminal" { root.menu-kind = 0; if root.menu-disk >= 0 && root.disks.length > 0 { root.action-on-disk("terminal", root.menu-disk); } else { root.action("disk-terminal"); } root.focus-files(); }
        else if action == "copy-disk-path" { root.menu-kind = 0; if root.menu-disk >= 0 && root.disks.length > 0 { root.action-on-disk("copy-path", root.menu-disk); } else { root.action("copy-disk-path"); } root.focus-files(); }
        else if action == "disk-properties" { root.menu-kind = 0; if root.menu-disk >= 0 && root.disks.length > 0 { root.action-on-disk("properties", root.menu-disk); } else { root.action("disk-properties"); } root.focus-files(); }
        else if action == "close-tab-menu" { root.menu-kind = 0; root.close-tab(root.menu-tab); root.focus-files(); }
        else if action == "close-other-tabs" { root.menu-kind = 0; root.action-on-tab("close-others", root.menu-tab); root.focus-files(); }
        else if action == "close-tabs-right" { root.menu-kind = 0; root.action-on-tab("close-right", root.menu-tab); root.focus-files(); }
        else if action == "duplicate-tab" { root.menu-kind = 0; root.action-on-tab("duplicate", root.menu-tab); root.focus-files(); }
        else if action == "copy-tab-path" { root.menu-kind = 0; root.action-on-tab("copy-path", root.menu-tab); root.focus-files(); }
