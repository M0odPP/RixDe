    function set-tooltip(active: bool, text: string, x: length, y: length) {
        if active && root.menu-kind == 0 && root.dialog-kind == 0 {
            root.tooltip-text = text;
            root.tooltip-x = x;
            root.tooltip-y = y;
        } else if root.tooltip-text == text {
            root.tooltip-text = "";
        }
    }
