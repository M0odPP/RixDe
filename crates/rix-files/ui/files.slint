        {action: "open-tab", label: @tr("Open in new tab"), shortcut: "", enabled: root.selection-count == 1 && root.menu-entry-is-dir && !root.trash-view && root.tabs.length < 12, checked: false, checkable: false, radio: false, destructive: false, separator: false},
        {action: "extract-here", label: @tr("Extract here"), shortcut: "", enabled: root.selection-count == 1 && root.menu-entry-is-archive && !root.trash-view && !root.operation-active, checked: false, checkable: false, radio: false, destructive: false, separator: false},
